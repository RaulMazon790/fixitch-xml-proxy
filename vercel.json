{
  "version": 2,
  "functions": {
    "api/*.js": {
      "runtime": "nodejs24.x"
    }
  },
  "rewrites": [
    {
      "source": "/firestore/:path*",
        { "key": "Access-Control-Allow-Headers", "value": "Authorization,Content-Type,Accept" }
    }
  ],
  "github": {
    "silent": true
  }
}
